{
  "name": "@lherman-cs/dev-workflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi role aliases and bounded child-session tools",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./node_modules/@narumitw/pi-lsp/dist/index.ts",
      "./node_modules/@narumitw/pi-github-pr/dist/index.ts",
      "./node_modules/@narumitw/pi-chrome-devtools/dist/index.ts",
      "./node_modules/@narumitw/pi-usage/dist/index.ts",
      "./node_modules/@sting8k/pi-vcc/index.ts",
      "./node_modules/pi-web-access/dist/index.js",
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./extension.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-mcp-adapter/skills"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@juicesharp/rpiv-ask-user-question": "2.10.1",
    "@juicesharp/rpiv-todo": "2.10.1",
    "@narumitw/pi-chrome-devtools": "0.53.4",
    "@narumitw/pi-github-pr": "0.49.8",
    "@narumitw/pi-lsp": "0.49.8",
    "@narumitw/pi-usage": "0.60.10",
    "@sting8k/pi-vcc": "0.8.0",
    "pi-mcp-adapter": "2.34.0",
    "pi-web-access": "0.30.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "jiti": "2.7.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
