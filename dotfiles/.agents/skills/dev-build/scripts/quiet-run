#!/usr/bin/env bash
set -uo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: quiet-run <command> [args...]" >&2
  exit 2
fi

log_dir="${CODEX_LOG_DIR:-${TMPDIR:-/tmp}/codex-logs}"
mkdir -p "$log_dir"
log="$log_dir/$(date +%Y%m%d-%H%M%S)-$$.log"
start=$(date +%s)

"$@" >"$log" 2>&1
status=$?
elapsed=$(( $(date +%s) - start ))

printf -v rendered '%q ' "$@"
rendered=${rendered% }

if [ "$status" -eq 0 ]; then
  printf 'PASS (%ss): %s\n' "$elapsed" "$rendered"
  printf 'log: %s\n' "$log"
else
  printf 'FAIL %s (%ss): %s\n' "$status" "$elapsed" "$rendered" >&2
  printf 'log: %s\n' "$log" >&2
  tail -n "${CODEX_LOG_TAIL:-200}" "$log" >&2
fi

exit "$status"
