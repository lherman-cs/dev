{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "NO_CHANGE",
        "ACCEPTED",
        "CHANGES_REQUIRED",
        "BLOCKED",
        "REQUIRES_REPLANNING",
        "EVIDENCE",
        "PREPARED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "proof": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "proof"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "correctness",
              "design",
              "verification"
            ]
          },
          "requirement": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "closure": {
            "type": "string"
          },
          "alternative": {
            "type": "string"
          },
          "new_evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner",
          "kind",
          "requirement",
          "evidence",
          "impact",
          "closure",
          "alternative",
          "new_evidence"
        ],
        "additionalProperties": false
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "REFUTED"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "disposition",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "proof": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "proof"
        ],
        "additionalProperties": false
      }
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "boundary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "requirement": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            },
            "why_no_local_solution": {
              "type": "string"
            },
            "attempted_remedies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "decision_needed": {
              "type": "string"
            }
          },
          "required": [
            "requirement",
            "evidence",
            "why_no_local_solution",
            "attempted_remedies",
            "decision_needed"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rationale": {
              "type": "string"
            },
            "plans": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string"
                  },
                  "depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "obligations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "file",
                  "depends_on",
                  "obligations",
                  "checks"
                ],
                "additionalProperties": false
              }
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "rationale",
            "plans",
            "documents"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "attempt",
    "target",
    "revision",
    "verdict",
    "summary",
    "coverage",
    "findings",
    "resolutions",
    "responses",
    "progress",
    "next_action",
    "boundary",
    "proposal"
  ],
  "additionalProperties": false
}
