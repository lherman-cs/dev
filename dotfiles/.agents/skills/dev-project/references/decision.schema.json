{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "BUILD",
        "DIAGNOSE",
        "REVIEW",
        "INVESTIGATE",
        "ADJUDICATE",
        "MAINTAIN",
        "STOP_BLOCKED",
        "STOP_REPLAN"
      ]
    },
    "instruction": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "settled_decision": {
      "type": "string"
    },
    "replace_worker": {
      "type": "boolean"
    }
  },
  "required": [
    "attempt",
    "target",
    "action",
    "instruction",
    "evidence",
    "settled_decision",
    "replace_worker"
  ],
  "additionalProperties": false
}
